index 00000000..84f9fbb1
--- /dev/null
+++ b/perip/uart16550/rtl/uart_defines.v
@@ -0,0 +1,248 @@
+`ifdef _UART_DEFINES_V_
+`else
+	`define _UART_DEFINES_V_
+//////////////////////////////////////////////////////////////////////
+////                                                              ////
+////  uart_defines.v                                              ////
+////                                                              ////
+////                                                              ////
+////  This file is part of the "UART 16550 compatible" project    ////
+////  http://www.opencores.org/cores/uart16550/                   ////
