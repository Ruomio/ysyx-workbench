+
+module uart_transmitter (clk, wb_rst_i, lcr, tf_push, wb_dat_i, enable,
+                         stx_pad_o, tstate, tf_count, tx_reset, lsr_mask);
+
+input                             clk;
+input                             wb_rst_i;
+input [7:0]                       lcr;
+input                             tf_push;
+input [7:0]                       wb_dat_i;
+input                             enable;
