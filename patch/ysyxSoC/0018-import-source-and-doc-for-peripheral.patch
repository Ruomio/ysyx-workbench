+reg                               stx_o_tmp;
+reg                               parity_xor;  // parity of the word
+reg                               tf_pop;
+reg                               bit_out;
+
+// TX FIFO instance
+//
+// Transmitter FIFO signals
+wire [`UART_FIFO_WIDTH-1:0]     tf_data_in;
+wire [`UART_FIFO_WIDTH-1:0]     tf_data_out;
