 perip/psram/efabless/EF_PSRAM_CTRL.v         | 117 ++++++++++-
 perip/psram/efabless/EF_PSRAM_CTRL_defines.v |   1 +
 perip/psram/efabless/EF_PSRAM_CTRL_wb.v      |  28 +++
 perip/psram/psram.v                          | 208 +++++++++++--------
 4 files changed, 265 insertions(+), 89 deletions(-)
 create mode 100644 perip/psram/efabless/EF_PSRAM_CTRL_defines.v

diff --git a/perip/psram/efabless/EF_PSRAM_CTRL.v b/perip/psram/efabless/EF_PSRAM_CTRL.v
index b6e737e9..ec43986d 100644
--- a/perip/psram/efabless/EF_PSRAM_CTRL.v
+++ b/perip/psram/efabless/EF_PSRAM_CTRL.v
@@ -41,6 +41,8 @@
 `timescale              1ns/1ps
 `default_nettype        none
 
+`include "EF_PSRAM_CTRL_defines.v"
+
 module PSRAM_READER (
     input   wire            clk,
     input   wire            rst_n,
@@ -60,7 +62,11 @@ module PSRAM_READER (
     localparam  IDLE = 1'b0,
                 READ = 1'b1;
 
+`ifdef QPI_MODE
+    wire [7:0]  FINAL_COUNT = 14 + size*2; // was 22: Always read 1 word
+`else
     wire [7:0]  FINAL_COUNT = 19 + size*2; // was 27: Always read 1 word
+`endif
 
     reg         state, nstate;
     reg [7:0]   counter;
@@ -113,13 +119,33 @@ module PSRAM_READER (
             saddr <= {addr[23:0]};
 
     // Sample with the negedge of sck
+`ifdef QPI_MODE
+    wire[1:0] byte_index = {counter[7:0] + 8'b1}[2:1];
+`else
     wire[1:0] byte_index = {counter[7:1] - 8'd10}[1:0];
+`endif
     always @ (posedge clk)
+`ifdef QPI_MODE
+        if(counter >= 15 && counter <= FINAL_COUNT)
+`else
         if(counter >= 20 && counter <= FINAL_COUNT)
+`endif
             if(sck)
                 data[byte_index] <= {data[byte_index][3:0], din}; // Optimize!
 
-    assign dout     =   (counter < 8)   ?   {3'b0, CMD_EBH[7 - counter]}:
+    assign dout     =
+`ifdef QPI_MODE
+                        (counter == 0)   ?   {CMD_EBH[7:4]}      :
+                        (counter == 1)   ?   {CMD_EBH[3:0]}      :
+                        (counter == 2)   ?   saddr[23:20]        :
+                        (counter == 3)   ?   saddr[19:16]        :
+                        (counter == 4)   ?   saddr[15:12]        :
+                        (counter == 5)   ?   saddr[11:8]         :
+                        (counter == 6)   ?   saddr[7:4]          :
+                        (counter == 7)   ?   saddr[3:0]          :
+                        4'h0;
+`else  
+                        (counter < 8)   ?   {3'b0, CMD_EBH[7 - counter]}:
                         (counter == 8)  ?   saddr[23:20]        :
                         (counter == 9)  ?   saddr[19:16]        :
                         (counter == 10) ?   saddr[15:12]        :
@@ -127,8 +153,14 @@ module PSRAM_READER (
                         (counter == 12) ?   saddr[7:4]          :
                         (counter == 13) ?   saddr[3:0]          :
                         4'h0;
+`endif
 
-    assign douten   = (counter < 14);
+    assign douten   = 
+`ifdef QPI_MODE
+                        (counter < 8);
+`else
+                        (counter < 14);
+`endif
 
     assign done     = (counter == FINAL_COUNT+1);
 
@@ -161,7 +193,11 @@ module PSRAM_WRITER (
     localparam  IDLE = 1'b0,
                 WRITE = 1'b1;
 
+`ifdef QPI_MODE
+    wire[7:0]        FINAL_COUNT = 7 + size*2;
+`else
     wire[7:0]        FINAL_COUNT = 13 + size*2;
+`endif
 
     reg         state, nstate;
     reg [7:0]   counter;
@@ -212,6 +248,25 @@ module PSRAM_WRITER (
         else if((state == IDLE) && wr)
             saddr <= addr;
 
+`ifdef QPI_MODE
+    assign dout     =   (counter == 0)  ?   {CMD_38H[7:4]}      :
+                        (counter == 1)  ?   {CMD_38H[3:0]}      :
+                        (counter == 2)  ?   saddr[23:20]        :
+                        (counter == 3)  ?   saddr[19:16]        :
+                        (counter == 4)  ?   saddr[15:12]        :
+                        (counter == 5)  ?   saddr[11:8]         :
+                        (counter == 6)  ?   saddr[7:4]          :
+                        (counter == 7)  ?   saddr[3:0]          :
+                        (counter == 8)  ?   line[7:4]           :
+                        (counter == 9) ?   line[3:0]           :
+                        (counter == 10) ?   line[15:12]         :
+                        (counter == 11) ?   line[11:8]          :
+                        (counter == 12) ?   line[23:20]         :
+                        (counter == 13) ?   line[19:16]         :
+                        (counter == 14) ?   line[31:28]         :
+                        line[27:24];
+
+`else
     assign dout     =   (counter < 8)   ?   {3'b0, CMD_38H[7 - counter]}:
                         (counter == 8)  ?   saddr[23:20]        :
                         (counter == 9)  ?   saddr[19:16]        :
@@ -227,6 +282,7 @@ module PSRAM_WRITER (
                         (counter == 19) ?   line[19:16]         :
                         (counter == 20) ?   line[31:28]         :
                         line[27:24];
+`endif
 
     assign douten   = (~ce_n);
 
@@ -234,3 +290,60 @@ module PSRAM_WRITER (
 
 
 endmodule
+
+module PSRAM_QPI(
+    input   wire            clk,
+    input   wire            rst_n,
+    output  wire            done,
+    output  reg             is_qpi,
+
+    output  reg             sck,
+    output  reg             ce_n,
+    input   wire [3:0]      din,
+    output  wire [3:0]      dout,
+    output  wire            douten
+
+);
+
+    reg [3:0] cnt;
+    wire [7:0] cmd = 8'h35;
+
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin
+            cnt <= 4'b0;
+            is_qpi <= 1'b0;
+            sck <= 1'b0;
+            ce_n <= 1'b1;
+        end
+        else if(!is_qpi && ce_n) begin
+            ce_n <= 1'b0;
+        end
+        else if(!is_qpi) begin
+            sck <= ~sck;
+
+            if(sck) begin
+                cnt <= cnt + 4'b1;
+            end
+            else begin
+                cnt <= cnt;
+            end
+            if(cnt == 4'd8) begin
+                is_qpi <= 1'b1;
+                ce_n <= 1'b1;
+            end
+            else begin
+                is_qpi <= 1'b0;
+            end
+        end
+        else begin
+            is_qpi <= 1'b1;
+        end
+    end
+
+    assign dout = {3'b0, cmd[3'd7-cnt[2:0]]};
+
+    assign douten = ~ce_n;
+
+    assign done = cnt == 4'd8;
+
+endmodule
