     );
 
+    PSRAM_QPI u_QPI (
+        .clk(clk_i),
+        .rst_n(~rst_i),
+        .done(qpi_done),
+        .is_qpi(is_qpi),
+        .sck(qpi_sck),
+        .ce_n(qpi_ce_n),
+        .din(qpi_din),
+        .dout(qpi_dout),
+        .douten(qpi_doe)
+    );
+
+`ifdef QPI_MODE
+    assign sck  = !is_qpi ? qpi_sck : wb_we ? mw_sck  : mr_sck;
+    assign ce_n = !is_qpi ? qpi_ce_n : wb_we ? mw_ce_n : mr_ce_n;
+    assign dout = !is_qpi ? qpi_dout : wb_we ? mw_dout : mr_dout;
+    assign douten  = !is_qpi ? {4{qpi_doe}} : wb_we ? {4{mw_doe}}  : {4{mr_doe}};
+`else
     assign sck  = wb_we ? mw_sck  : mr_sck;
     assign ce_n = wb_we ? mw_ce_n : mr_ce_n;
     assign dout = wb_we ? mw_dout : mr_dout;
     assign douten  = wb_we ? {4{mw_doe}}  : {4{mr_doe}};
+`endif
 
     assign mw_din = din;
     assign mr_din = din;
