diff --git a/perip/spi/rtl/xip.v b/perip/spi/rtl/xip.v
new file mode 100644
index 00000000..d4fd94eb
--- /dev/null
+++ b/perip/spi/rtl/xip.v
@@ -0,0 +1,205 @@
+module XIP(
+  input clk,
+  input rst,
+  input [31:0] in_paddr,
+  input in_pwrite,
+  input [31:0] in_pwdata,
+  input [3:0] in_pstrb,
+  input in_psel,
+  input in_penable,
+  output reg [31:0] xip_prdata,
+  output reg xip_pslverr,
+  output reg xip_pready,
+  output reg xip_spi_irq,
+
+  output reg xip_mod,
+  output reg [4:0] wb_adr_i,
+  output reg [31:0] wb_dat_i,
+  input [31:0] wb_dat_o,
+  output reg [3:0] wb_sel_i,
+  output reg wb_we_i,
+  output reg wb_stb_i,
+  output reg wb_cyc_i,
+  input wb_ack_o,
+  input wb_err_o,
+  input wb_int_o
+);
+
+  import "DPI-C" function void flash_write(input int addr, input int strb, input int data);
+
+  wire in_flash;
+
+  reg wb_cyc_i_tmp;
+  reg [3:0] state;
+  // 3'd0: wait xip_mod; 3'd1: wait write cmd; 3'd2: wait write divider; 3'3: write ss; 3'd4 write ctrl;
+  // 3'd5: waite go-bit; 3'd6: write ctrl 2nd; 3'd7: wait go-bit 2nd; 3'd8: read flash data;
+
+  assign in_flash = (in_paddr >= 32'h30000000) && (in_paddr < 32'h40000000);
+  assign xip_mod = in_flash;
+
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 'b0;
+    end
+    else begin
+      case(state)
+        'd0: begin
+          // IDLE
+          wb_we_i <= 1'b0;
+          wb_stb_i <= 1'b0;
+
+          if(in_flash && xip_mod && in_psel && !in_penable && !in_pwrite) begin
+            state <= 'd1;
+          end
+        end
+        'd1: begin
+          wb_adr_i <= 5'b0;
+          wb_dat_i <= {8'h03, in_paddr[23:2], 2'b0};
+          wb_sel_i <= 4'b1111;
+          wb_we_i <= 1'b1;
+          wb_stb_i <= 1'b1;
+          wb_cyc_i <= 'b1;
+
+          if(wb_ack_o) begin
+            wb_cyc_i <= 1'b0;
+            wb_stb_i <= 1'b0;
+            state <= 4'd2;
+          end
+        end
+        'd2: begin
+          wb_adr_i <= 5'b10100;
+          wb_dat_i <= 32'b1;    // divider
+          wb_sel_i <= 4'b1111;
+          wb_we_i <= 1'b1;
+          wb_stb_i <= 1'b1;
+          wb_cyc_i <= 'b1;
+
+          if(wb_ack_o) begin
+            wb_cyc_i <= 1'b0;
+            wb_stb_i <= 1'b0;
+
+            state <= 4'd3;
+          end
+        end
+        'd3: begin
+          wb_adr_i <= 5'b11000;
+          wb_dat_i <= 32'b1;    // ss, 0-bit is flash
+          wb_sel_i <= 4'b1111;
+          wb_we_i <= 1'b1;
+          wb_stb_i <= 1'b1;
+          wb_cyc_i <= 'b1;
+
+          if(wb_ack_o) begin
+            wb_cyc_i <= 1'b0;
+            wb_stb_i <= 1'b0;
+
+            state <= 4'd4;
+          end
+        end
+        'd4: begin
+          wb_adr_i <= 5'b10000;
+          wb_dat_i <= 32'h00000120;
+          wb_sel_i <= 4'b1111;
+          wb_we_i <= 1'b1;
+          wb_stb_i <= 1'b1;
+          wb_cyc_i <= 'b1;
+
+          if(wb_ack_o) begin
+            wb_cyc_i <= 1'b0;
+            wb_stb_i <= 1'b0;
+
+            state <= 4'd5;
+          end
+        end
+        'd5: begin
+          if((wb_dat_o & 32'h100) == 32'b0)
+            state <= 4'd6;
+        end
+        'd6: begin
+          wb_adr_i <= 5'b10000;
+          wb_dat_i <= 32'h00000120;
+          wb_sel_i <= 4'b1111;
+          wb_we_i <= 1'b1;
+          wb_stb_i <= 1'b1;
+          wb_cyc_i <= 'b1;
+
+          if(wb_ack_o) begin
+            wb_cyc_i <= 1'b0;
+            wb_stb_i <= 1'b0;
+
+            state <= 4'd7;
+          end
+        end
+        'd7: begin
+          if((wb_dat_o & 32'h100) == 32'b0)
+            state <= 4'd8;
+        end
+        'd8: begin
+          wb_adr_i <= 5'b00000;
+          wb_dat_i <= 32'h0;
+          wb_sel_i <= 4'b0000;
+          wb_we_i <= 1'b1;
+          wb_stb_i <= 1'b1;
+          wb_cyc_i <= 'b1;
+
+          if(wb_ack_o) begin
+            wb_cyc_i <= 1'b0;
+            wb_stb_i <= 1'b0;
+
+            state <= 4'd9;
+          end
+        end
+        'd9: begin
+          xip_prdata <= {wb_dat_o[7:0], wb_dat_o[15:8], wb_dat_o[23:16], wb_dat_o[31:24]};
+          xip_pready <= in_penable & in_psel & ~xip_pready;
+          xip_pslverr <= 1'b0;
+
+          wb_adr_i <= 5'b11000;
+          wb_dat_i <= 32'b0;    // ss, 0-bit is flash
+          wb_sel_i <= 4'b1111;
+          wb_we_i <= 1'b1;
+          wb_stb_i <= 1'b1;
+          wb_cyc_i <= 'b1;
+
+          if(wb_ack_o) begin
+            wb_cyc_i <= 1'b0;
+            wb_stb_i <= 1'b0;
+            wb_adr_i <= 5'b00000;
+            wb_dat_i <= 32'b0;    // ss, 0-bit is flash
+            wb_sel_i <= 4'b0000;
+            wb_we_i <= 1'b0;
+            wb_stb_i <= 1'b0;
+
+            state <= 4'd0;
+          end
+        end
+        default: begin
+
+        end
+      endcase
+    end
+  end
+
+  always @(posedge clk) begin
+    if(rst) begin
+
+    end
+    else if(xip_mod && in_psel && !in_penable) begin
+      xip_pready <= 'b0;
+    end
+    else if(xip_mod && in_pwrite && in_psel && in_penable && !xip_pready) begin
+      flash_write(in_paddr, {28'b0, in_pstrb}, in_pwdata);
+      xip_pready <= 'b1;
+    end
+
+  end
+
+
+
+  // always @(xip_mod or in_pwrite) begin
+  //   if(xip_mod && in_pwrite)
+  //     $error("flash should not be writen.");
+
+  // end
+
+endmodule
