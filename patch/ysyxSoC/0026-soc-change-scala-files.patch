diff --git a/perip/sdram/sdram.v b/perip/sdram/sdram.v
index c5f73de6..0e29a28a 100644
--- a/perip/sdram/sdram.v
+++ b/perip/sdram/sdram.v
@@ -1,4 +1,74 @@
 module sdram(
+  input        clk,
+  input        cke,
+  input        cs,
+  input        ras,
+  input        cas,
+  input        we,
+  input [15:0] a,
+  input [ 1:0] ba,
+  input [ 3:0] dqm,
+  inout [31:0] dq
+);
+
+  sdram_word_extend_low sdram_0(
+    .clk (clk),	
+    .cke (cke),	
+    .id (2'b00),
+    .cs  (cs),	
+    .ras (ras),	
+    .cas (cas),	
+    .we  (we),	
+    .a   (a),	
+    .ba  (ba),	
+    .dqm (dqm),	
+    .dq  (dq[31:16])
+  );
+
+  sdram_word_extend_low sdram_1 (	
+    .clk (clk),	
+    .cke (cke),	
+    .id (2'b01),
+    .cs  (cs),	
+    .ras (ras),	
+    .cas (cas),	
+    .we  (we),	
+    .a   (a),	
+    .ba  (ba),	
+    .dqm (dqm),	
+    .dq  (dq[15:0])
+  );
+
+  sdram_word_extend_high sdram_2 (	
+    .clk (clk),	
+    .cke (cke),	
+    .id (2'b10),
+    .cs  (cs),	
+    .ras (ras),	
+    .cas (cas),	
+    .we  (we),	
+    .a   (a),	
+    .ba  (ba),	
+    .dqm (dqm),	
+    .dq  (dq[31:16])
+  );	
+  sdram_word_extend_high sdram_3 (	
+    .clk (clk),	
+    .cke (cke),	
+    .id (2'b11),
+    .cs  (cs),	
+    .ras (ras),	
+    .cas (cas),	
+    .we  (we),	
+    .a   (a),	
+    .ba  (ba),	
+    .dqm (dqm),	
+    .dq  (dq[15:0])
+  );	
+
+endmodule
+
+module sdram_word_extend_low(
   input        clk,
   input        cke,
   input [1:0]  id,
@@ -187,7 +257,7 @@ module sdram(
 
 endmodule
 
-module sdram_word_extend(
+module sdram_word_extend_high(
   input        clk,
   input        cke,
   input [1:0]  id,
diff --git a/src/CPU.scala b/src/CPU.scala
index 7559195f..e34611d5 100644
--- a/src/CPU.scala
+++ b/src/CPU.scala
@@ -13,7 +13,7 @@ object CPUAXI4BundleParameters {
   def apply() = AXI4BundleParameters(addrBits = 32, dataBits = 32, idBits = ChipLinkParam.idBits)
 }
 
-class ysyx_00000000 extends BlackBox {
+class ysyx_24080020 extends BlackBox {
   val io = IO(new Bundle {
     val clock = Input(Clock())
     val reset = Input(Reset())
@@ -35,7 +35,7 @@ class CPU(idBits: Int)(implicit p: Parameters) extends LazyModule {
     val interrupt = IO(Input(Bool()))
     val slave = IO(Flipped(AXI4Bundle(CPUAXI4BundleParameters())))
 
-    val cpu = Module(new ysyx_00000000)
+    val cpu = Module(new ysyx_24080020)
     cpu.io.clock := clock
     cpu.io.reset := reset
     cpu.io.io_interrupt := interrupt
