-  //  wstrb <= wstrb_1; 
-  //end
 
   // cke
   always @(posedge clk) begin
@@ -59,6 +57,7 @@ module sdram(
       cas_counter <= 2'b0;
       r_en <= 1'b0;
       w_en <= 1'b0;
+      bank_en <= 4'b0;
     end
   end
   // Initialize mode register
@@ -73,14 +72,16 @@ module sdram(
   // Activate command
   always @(posedge clk) begin
     if (cmd_active) begin
-      row_addr <= a;
+      row_addr[ba] <= a;
       bank_addr <= ba;
+      bank_en[ba] <= 1'b1;
     end
   end
 
   // Read command
   always @(posedge clk) begin
     if (cmd_read) begin
+      bank_addr <= ba;
       r_en <= 1'b1;
       col_addr <= a[9:0];
       auto_precharge <= a[10];
@@ -96,22 +97,22 @@ module sdram(
       col_addr <= a[9:0];
       auto_precharge <= a[10];
       burst_counter <= 1;
-      // memory[{bank_addr, row_addr, col_addr}] <= dq;
-      sdram_write({6'b0, bank_addr}, {19'b0, row_addr}, {22'b0, a[9:0]}, wstrb, dq & wstrb);
+      bank_addr <= ba;
+      sdram_write({6'b0, ba}, {19'b0, row_addr[ba]}, {22'b0, a[9:0]}, wstrb, {{16{1'b0}}, dq & wstrb});
     end
   end
 
   // Precharge command
   always @(posedge clk) begin
     if (cmd_precharge) begin
