-      //  dq_out <= memory[{bank_addr, row_addr, col_addr + burst_counter}];
-      sdram_write({6'b0,bank_addr}, {19'b0, row_addr}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, dq & wstrb);
+    else if (w_en && burst_counter <= burst_length && !is_term && !cmd_write && !cmd_burst_term) begin
+      sdram_write({6'b0,bank_addr}, {19'b0, row_addr[bank_addr]}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, {{16{1'b0}}, dq & wstrb});
       burst_counter <= burst_counter + 1;
     end
     else if(w_en) begin
@@ -165,14 +173,7 @@ module sdram(
 
     end
   end
-  // NOP
-  always @(posedge clk) begin
-    if(r_en) begin
-
 
-    end
-
-  end
 
   // Data bus control
   assign dq = dq_en ? dq_out : 16'bz;
