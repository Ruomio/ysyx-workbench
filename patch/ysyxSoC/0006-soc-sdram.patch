+    else if (r_en && cas_counter == cas_latency - 2'b1 && burst_counter <= burst_length && !is_term) begin
+      sdram_read({6'b0,bank_addr}, {19'b0, row_addr[bank_addr]}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, {{16{1'b0}}, dq_out});
       dq_en <= 1;
       burst_counter <= burst_counter + 1;
     end
@@ -150,13 +155,16 @@ module sdram(
 
   // Data input
   always @(posedge clk) begin
-    if (w_en && burst_counter > burst_length) begin
