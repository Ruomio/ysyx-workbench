-      //   // Precharge all banks
-      //   row_addr <= 13'b0;
-      //   bank_addr <= 2'b0;
-      // end else begin
-      //   // Precharge selected bank
-      //   row_addr <= 13'b0;
-      // end
+      if (a[10]) begin
+        // Precharge all banks
+        bank_en <= 4'b0;
+      end else begin
+        // Precharge selected bank
+        bank_en[ba] <= 1'b0;
+      end
+
     end
   end
 
@@ -119,23 +120,27 @@ module sdram(
   always @(posedge clk) begin
     if (cmd_burst_term) begin
       burst_counter <= 0;
+      cas_counter <= 2'b0;
       r_en <= 1'b0;
       w_en <= 1'b0;
-
+      dq_en <= 1'b0;
     end
   end
 
   // Data output
   always @(posedge clk) begin
-    if (r_en && cas_counter == cas_latency - 2'b1 && burst_counter > burst_length) begin
+    if (r_en && cas_counter == cas_latency - 2'b1 && burst_counter > burst_length && !is_term) begin
       r_en <= 1'b0;
       cas_counter <= 2'b0;
       burst_counter <= 3'b0;
       dq_en <= 1'b0;
+      if(auto_precharge) begin
+        bank_en[bank_addr] <= 1'b0;
+        auto_precharge <= 1'b0;
+      end
