From 5f836d2dc8446c6ff4badf2b1bb88660f3d9ccbc Mon Sep 17 00:00:00 2001
From: Ruomio <1065940593@qq.com>
Date: Fri, 27 Dec 2024 16:00:12 +0800
Subject: [PATCH 01/26] soc: achive bitrev

---
 perip/bitrev/bitrev.v       |  35 +++-
 perip/spi/rtl/spi_top_apb.v | 403 +++++++++++++++++++++++++++++++++++-
 2 files changed, 427 insertions(+), 11 deletions(-)

diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..e10bb49c 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -4,5 +4,38 @@ module bitrev (
   input  mosi,
   output miso
 );
-  assign miso = 1'b1;
+  reg [7:0] rx_buf = 8'b0;
+  // reg [7:0] tx_buf;
+  reg miso_reg = 1'b1;
+
+  reg [3:0] bit_cnt;
+
+
+  assign miso = miso_reg;
+
+  always @(posedge sck) begin
+    if(ss) begin
+      miso_reg <= 1'b1;
+    end
+    if(!ss && bit_cnt <= 4'b111) begin
+      // valid
+      bit_cnt <= bit_cnt + 4'b1;
+      rx_buf <= (rx_buf << 1) | {{7{1'b0}}, mosi};
+      miso_reg <= 1'b0;
+    end
+    else if(!ss && (bit_cnt != 4'b1111)) begin
+      // transport rev data
+      bit_cnt <= bit_cnt + 4'b1;
+      rx_buf <= rx_buf >> 1'b1;
+      miso_reg <= rx_buf[1];
+    end
+    else begin
+      miso_reg <= 1'b1;
+      bit_cnt <= 4'b0;
+    end
+
+  end
+
+
+
 endmodule
diff --git a/perip/spi/rtl/spi_top_apb.v b/perip/spi/rtl/spi_top_apb.v
index 92d37516..0a032f70 100644
--- a/perip/spi/rtl/spi_top_apb.v
+++ b/perip/spi/rtl/spi_top_apb.v
@@ -51,16 +51,16 @@ assign in_prdata  = data[31:0];
 spi_top u0_spi_top (
   .wb_clk_i(clock),
   .wb_rst_i(reset),
-  .wb_adr_i(in_paddr[4:0]),
-  .wb_dat_i(in_pwdata),
-  .wb_dat_o(in_prdata),
-  .wb_sel_i(in_pstrb),
-  .wb_we_i (in_pwrite),
-  .wb_stb_i(in_psel),
-  .wb_cyc_i(in_penable),
-  .wb_ack_o(in_pready),
-  .wb_err_o(in_pslverr),
-  .wb_int_o(spi_irq_out),
+  .wb_adr_i(xip_mod_wire == 1'b1 ? wb_adr_i : in_paddr[4:0]),
+  .wb_dat_i(xip_mod_wire == 1'b1 ? wb_dat_i : in_pwdata),
+  .wb_dat_o(wb_dat_o),
+  .wb_sel_i(xip_mod_wire == 1'b1 ? wb_sel_i : in_pstrb),
+  .wb_we_i (xip_mod_wire == 1'b1 ? wb_we_i  : in_pwrite),
+  .wb_stb_i(xip_mod_wire == 1'b1 ? wb_stb_i : in_psel),
+  .wb_cyc_i(xip_mod_wire == 1'b1 ? wb_cyc_i : in_penable),
+  .wb_ack_o(wb_ack_o),
+  .wb_err_o(wb_ack_o),
+  .wb_int_o(wb_int_o),
 
   .ss_pad_o(spi_ss),
   .sclk_pad_o(spi_sck),
@@ -68,6 +68,389 @@ spi_top u0_spi_top (
   .miso_pad_i(spi_miso)
 );
 
+
+  assign in_pready = xip_mod_wire ? xip_pready : wb_ack_o;
+  assign in_prdata = xip_mod_wire ? xip_prdata : wb_dat_o;
+  assign in_pslverr = xip_mod_wire ? xip_pslverr : wb_err_o;
+  assign spi_irq_out = xip_mod_wire ? xip_spi_irq : wb_int_o;
+
+  wire xip_mod;
+  wire xip_mod_wire;
+  wire [4:0] wb_adr_i;
+  wire [31:0] wb_dat_i;
+  wire [31:0] wb_dat_o;
+  wire [3:0] wb_sel_i;
+  wire wb_we_i;
+  wire wb_stb_i;
+  wire wb_cyc_i;
+  wire wb_ack_o;
+  wire wb_err_o;
+  wire wb_int_o;
+  wire xip_pready;
+  wire [31:0] xip_prdata;
+  wire xip_pslverr;
+  wire xip_spi_irq;
+
+assign xip_mod_wire = xip_mod;
+assign xip_spi_irq = 1'b0;
+
+XIP u_xip(
+  .clk(clock),
+  .rst(reset),
+  .in_paddr(in_paddr),
+  .in_pwrite(in_pwrite),
+  .in_pstrb(in_pstrb),
+  .in_psel(in_psel),
+  .in_penable(in_penable),
+  .xip_prdata(xip_prdata),
+  .xip_pslverr(xip_pslverr),
+  .xip_pready(xip_pready),
+  .xip_spi_irq(xip_spi_irq),
+
+  .xip_mod(xip_mod),
+  .wb_adr_i(wb_adr_i),
+  .wb_dat_i(wb_dat_i),
+  .wb_dat_o(wb_dat_o),
+  .wb_sel_i(wb_sel_i),
+  .wb_we_i(wb_we_i),
+  .wb_stb_i(wb_stb_i),
+  .wb_cyc_i(wb_cyc_i),
+  .wb_ack_o(wb_ack_o),
+  .wb_err_o(wb_err_o),
+  .wb_int_o(wb_int_o)
+);
+
 `endif // FAST_FLASH
 
 endmodule
+
+module XIP(
+  input clk,
+  input rst,
+  input [31:0] in_paddr,
+  input in_pwrite,
+  input [3:0] in_pstrb,
+  input in_psel,
+  input in_penable,
+  output reg [31:0] xip_prdata,
+  output reg xip_pslverr,
+  output reg xip_pready,
+  output reg xip_spi_irq,
+
+  output reg xip_mod,
+  output reg [4:0] wb_adr_i,
+  output reg [31:0] wb_dat_i,
+  input [31:0] wb_dat_o,
+  output reg [3:0] wb_sel_i,
+  output reg wb_we_i,
+  output reg wb_stb_i,
+  output reg wb_cyc_i,
+  input wb_ack_o,
+  input wb_err_o,
+  input wb_int_o
+);
+
+  reg noth;
+  reg wb_cyc_i_tmp;
+  reg [3:0] state; 
+  // 3'd0: wait xip_mod; 3'd1: wait write cmd; 3'd2: wait write divider; 3'3: write ss; 3'd4 write ctrl;
+  // 3'd5: waite go-bit; 3'd6: write ctrl 2nd; 3'd7: wait go-bit 2nd; 3'd8: read flash data;
+
+  always @(posedge clk) begin
+    if(rst) begin
+      xip_mod <= 1'b0;
+    end
+    else if((in_paddr >= 32'h30000000 && in_paddr < 32'h40000000) && !xip_mod && (in_psel && !in_penable)) begin
+      xip_mod <= 1'b1;
+      state <= 4'b1;
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  always @(xip_mod or in_pwrite) begin
+    if(xip_mod && in_pwrite)
+      $error("flash should not be writen.");
+
+  end
+
+  // xip: write data to spi-reg, then waite go-bit become zero, read and process data from spi-rx-reg
+  // step 1: write data to add flash read command, offset = 0x0
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+      wb_cyc_i_tmp <= 1'b0;
+      wb_cyc_i <= 1'b0;
+    end
+    else if(state == 4'd1) begin
+      wb_adr_i <= 5'b0;
+      wb_dat_i <= {8'h03, in_paddr[23:0]};
+      wb_sel_i <= 4'b1111;
+      wb_we_i <= 1'b1;
+      wb_stb_i <= 1'b1;
+
+      wb_cyc_i_tmp <= 1'b1;
+
+      if(wb_ack_o) begin
+        wb_cyc_i_tmp <= 1'b0;
+        wb_cyc_i <= 1'b0;
+        wb_stb_i <= 1'b0;
+
+        state <= 4'd2;
+      end
+      else if(wb_cyc_i_tmp) begin
+        wb_cyc_i <= 1'b1;
+      end
+      else begin
+        noth <= 1'b0;
+      end
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 2: write divider, offset = 0x14
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd2) begin
+      wb_adr_i <= 5'b10100;
+      wb_dat_i <= 32'b1;    // divider
+      wb_sel_i <= 4'b1111;
+      wb_we_i <= 1'b1;
+      wb_stb_i <= 1'b1;
+
+      wb_cyc_i_tmp <= 1'b1;
+
+      if(wb_ack_o) begin
+        wb_cyc_i_tmp <= 1'b0;
+        wb_cyc_i <= 1'b0;
+        wb_stb_i <= 1'b0;
+
+        state <= 4'd3;
+      end
+      else if(wb_cyc_i_tmp) begin
+        wb_cyc_i <= 1'b1;
+      end
+      else begin
+        noth <= 1'b0;
+      end
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 3: write ss, offset = 0x18
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd3) begin
+      wb_adr_i <= 5'b11000;
+      wb_dat_i <= 32'b1;    // ss, 0-bit is flash
+      wb_sel_i <= 4'b1111;
+      wb_we_i <= 1'b1;
+      wb_stb_i <= 1'b1;
+
+      wb_cyc_i_tmp <= 1'b1;
+
+      if(wb_ack_o) begin
+        wb_cyc_i_tmp <= 1'b0;
+        wb_cyc_i <= 1'b0;
+        wb_stb_i <= 1'b0;
+
+        state <= 4'd4;
+      end
+      else if(wb_cyc_i_tmp) begin
+        wb_cyc_i <= 1'b1;
+      end
+      else begin
+        noth <= 1'b0;
+      end
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 4: write ctrl, offset = 0x10
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd4) begin
+      wb_adr_i <= 5'b10000;
+      wb_dat_i <= 32'h00000120;
+      // case(in_pstrb)
+      //   4'b0001: wb_dat_i <= 32'h00000108;
+      //   4'b0011: wb_dat_i <= 32'h00000110;
+      //   4'b1111: wb_dat_i <= 32'h00000120;
+      //   default: wb_dat_i <= 32'b0;
+      // endcase
+      wb_sel_i <= 4'b1111;
+      wb_we_i <= 1'b1;
+      wb_stb_i <= 1'b1;
+
+      wb_cyc_i_tmp <= 1'b1;
+
+      if(wb_ack_o) begin
+        wb_cyc_i_tmp <= 1'b0;
+        wb_cyc_i <= 1'b0;
+        wb_stb_i <= 1'b0;
+
+        state <= 4'd5;
+      end
+      else if(wb_cyc_i_tmp) begin
+        wb_cyc_i <= 1'b1;
+      end
+      else begin
+        noth <= 1'b0;
+      end
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 5: wait go-bit become zero
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd5) begin
+      if((wb_dat_o & 32'h100) == 32'b0)
+        state <= 4'd6;
+      else state <= 4'd5;
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 6: write ctrl 2nd, offset = 0x10
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd6) begin
+      wb_adr_i <= 5'b10000;
+      wb_dat_i <= 32'h00000120;
+      // case(in_pstrb)
+      //   4'b0001: wb_dat_i <= 32'h00000108;
+      //   4'b0011: wb_dat_i <= 32'h00000110;
+      //   4'b1111: wb_dat_i <= 32'h00000120;
+      //   default: wb_dat_i <= 32'b0;
+      // endcase
+      wb_sel_i <= 4'b1111;
+      wb_we_i <= 1'b1;
+      wb_stb_i <= 1'b1;
+
+      wb_cyc_i_tmp <= 1'b1;
+
+      if(wb_ack_o) begin
+        wb_cyc_i_tmp <= 1'b0;
+        wb_cyc_i <= 1'b0;
+        wb_stb_i <= 1'b0;
+
+        state <= 4'd7;
+      end
+      else if(wb_cyc_i_tmp) begin
+        wb_cyc_i <= 1'b1;
+      end
+      else begin
+        noth <= 1'b0;
+      end
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 7: wait go-bit become zero 2nd
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd7) begin
+      if((wb_dat_o & 32'h100) == 32'b0)
+        state <= 4'd8;
+      else state <= 4'd7;
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 8: set adr_i zero to get data, offset = 0x00
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd8) begin
+      wb_adr_i <= 5'b00000;
+      wb_dat_i <= 32'h0;
+      wb_sel_i <= 4'b0000;
+      wb_we_i <= 1'b1;
+      wb_stb_i <= 1'b1;
+
+      wb_cyc_i_tmp <= 1'b1;
+
+      if(wb_ack_o) begin
+        wb_cyc_i_tmp <= 1'b0;
+        wb_cyc_i <= 1'b0;
+        wb_stb_i <= 1'b0;
+
+        state <= 4'd9;
+      end
+      else if(wb_cyc_i_tmp) begin
+        wb_cyc_i <= 1'b1;
+      end
+      else begin
+        noth <= 1'b0;
+      end
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 9: read flash data and return 
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd9) begin
+      xip_prdata <= {wb_dat_o[7:0], wb_dat_o[15:8], wb_dat_o[23:16], wb_dat_o[31:24]};
+      xip_pready <= in_penable & in_psel & ~xip_pready;
+      xip_pslverr <= 1'b0;
+
+      // xip_mod <= 1'b0;
+      state <= 4'd10;
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+
+  // step 10: set pready zero 
+  always @(posedge clk) begin
+    if(rst) begin
+      state <= 4'b0;
+    end
+    else if(state == 4'd10) begin
+      xip_prdata <= {wb_dat_o[7:0], wb_dat_o[15:8], wb_dat_o[23:16], wb_dat_o[31:24]};
+      xip_pready <= in_penable & in_psel & ~xip_pready;
+      xip_pslverr <= 1'b0;
+
+      xip_mod <= 1'b0;
+      state <= 4'd0;
+    end
+    else begin
+      noth <= 1'b0;
+    end
+  end
+endmodule
-- 
