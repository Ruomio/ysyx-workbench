+module sdram_word_exten(
+  input        clk,
+  input        cke,
+  input [1:0]  id,
+  input        cs,
+  input        ras,
+  input        cas,
+  input        we,
+  input [15:0] a,
+  input [ 1:0] ba,
+  input [ 3:0] dqm,
+  inout [15:0] dq
+);
+  import "DPI-C" function void sdram_read(input byte id, input byte ba, input int row_addr, input int col_addr, input int wstrb, output int rdata);
+  import "DPI-C" function void sdram_write(input byte id, input byte ba, input int row_addr, input int col_addr, input int wstrb, input int wdata);
+
+  // Internal registers and wires
+  // reg [15:0] memory [0:262143]; // 256Mb SDRAM (16M x 16)
+  reg [15:0] dq_out;
+  reg dq_en;
+  reg [15:0] row_addr [3:0];
+  reg [1:0] bank_addr;
+  reg [9:0] col_addr;
+  reg [2:0] burst_length;
+  reg [1:0] cas_latency;
+  reg [2:0] burst_counter;
+  reg [1:0] cas_counter;
+  reg auto_precharge;
+  reg [12:0] mode_register;
+  reg [1:0] precharge_cnt;
+  reg [3:0] bank_en;
+
+
+  reg r_en;
+  reg w_en;
+
+
+  wire [31:0] wstrb;
+  wire is_term;
+
+  // Command decoding
+  wire cmd_nop = ~cs & ras & cas & we;
+  wire cmd_active = ~cs & ~ras & cas & we;
+  wire cmd_read = ~cs & ras & ~cas & we;
+  wire cmd_write = ~cs & ras & ~cas & ~we;
+  wire cmd_precharge = ~cs & ~ras & cas & ~we;
+  wire cmd_refresh = ~cs & ~ras & ~cas & we;
+  wire cmd_burst_term = ~cs & ras & cas & ~we;
+  wire cmd_load_mode = ~cs & ~ras & ~cas & ~we;
+
+  assign is_term = cmd_burst_term;
+  // wstrb
+  assign wstrb = { {8{~dqm[3]}}, {8{~dqm[2]}}, {8{~dqm[1]}}, {8{~dqm[0]}} }; 
+
+  // cke
+  always @(posedge clk) begin
+    if(!cke) begin
+      cas_counter <= 2'b0;
+      r_en <= 1'b0;
+      w_en <= 1'b0;
+      bank_en <= 4'b0;
+    end
+  end
+  // Initialize mode register
+  always @(posedge clk) begin
+    if (cmd_load_mode) begin
+      mode_register <= a[12:0]; // Burst length and CAS latency
+      burst_length <= a[2:0];
+      cas_latency <= a[5:4];
+    end
+  end
+
+  // Activate command
+  always @(posedge clk) begin
+    if (cmd_active && id[1] == 1'b1) begin
+      row_addr[ba] <= a;
+      bank_addr <= ba;
+      bank_en[ba] <= 1'b1;
+    end
+  end
+
+  // Read command
+  always @(posedge clk) begin
+    if (cmd_read && id[1] == 1'b1) begin
+      bank_addr <= ba;
+      r_en <= 1'b1;
+      col_addr <= a[9:0];
+      auto_precharge <= a[10];
+      burst_counter <= 0;
+      cas_counter <= 2'b1;
+    end
+  end
+
+  // Write command
+  always @(posedge clk) begin
+    if (cmd_write && id[1] == 1'b1) begin
+      w_en <= 1'b1;
+      col_addr <= a[9:0];
+      auto_precharge <= a[10];
+      burst_counter <= 1;
+      bank_addr <= ba;
+      if((id[1] == 1'b0) && row_addr[bank_addr] < 16'h2000) begin
+        sdram_write({6'b0,id}, {6'b0, ba}, {16'b0, row_addr[ba]}, {22'b0, a[9:0]}, wstrb, {{16{1'b0}}, dq});
+      end
+      else if((id[1] == 1'b1) && row_addr[bank_addr] >= 16'h2000) begin
+        sdram_write({6'b0,id}, {6'b0, ba}, {16'b0, row_addr[ba]}, {22'b0, a[9:0]}, wstrb, {{16{1'b0}}, dq});
+      end
+    end
+  end
+
+  // Precharge command
+  always @(posedge clk) begin
+    if (cmd_precharge && id[1] == 1'b1) begin
+      if (a[10]) begin
+        // Precharge all banks
+        bank_en <= 4'b0;
+      end else begin
+        // Precharge selected bank
+        bank_en[ba] <= 1'b0;
+      end
+
+    end
+  end
+
+  // Burst terminate command
+  always @(posedge clk) begin
+    if (cmd_burst_term && id[1] == 1'b1) begin
+      burst_counter <= 0;
+      cas_counter <= 2'b0;
+      r_en <= 1'b0;
+      w_en <= 1'b0;
+      dq_en <= 1'b0;
+    end
+  end
+
+  // Data output
+  always @(posedge clk) begin
+    if (r_en && cas_counter == cas_latency - 2'b1 && burst_counter > burst_length && !is_term && id[1] == 1'b1) begin
+      r_en <= 1'b0;
+      cas_counter <= 2'b0;
+      burst_counter <= 3'b0;
+      dq_en <= 1'b0;
+      if(auto_precharge) begin
+        bank_en[bank_addr] <= 1'b0;
+        auto_precharge <= 1'b0;
+      end
+    end
+    else if (r_en && cas_counter == cas_latency - 2'b1 && burst_counter <= burst_length && !is_term && id[1] == 1'b1) begin
+      if(id[1] == 1'b0 && row_addr[bank_addr] < 16'h2000) begin
+        sdram_read({6'b0,id}, {6'b0,bank_addr}, {16'b0, row_addr[bank_addr]}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, {{16{1'b0}}, dq_out});
+      end
+      else if(id[1] == 1'b1 && row_addr[bank_addr] >= 16'h2000) begin
+        sdram_read({6'b0,id}, {6'b0,bank_addr}, {16'b0, row_addr[bank_addr]}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, {{16{1'b0}}, dq_out});
+      end
+      dq_en <= 1;
+      burst_counter <= burst_counter + 1;
+    end
+    else if(r_en && id[1] == 1'b1) begin
+      cas_counter <= cas_counter + 1;
+      dq_en <= 0;
+    end
+    else begin
+
+    end
+  end
+
+  // Data input
+  always @(posedge clk) begin
+    if (w_en && burst_counter > burst_length && !is_term && !cmd_write && id[1] == 1'b1) begin
+      w_en <= 1'b0;
+      burst_counter <= 3'b0;
+      if(auto_precharge) begin
+        bank_en[bank_addr] <= 1'b0;
+        auto_precharge <= 1'b0;
+      end
+    end
+    else if (w_en && burst_counter <= burst_length && !is_term && !cmd_write && !cmd_burst_term && id[1] == 1'b1) begin
+      if(id[1] == 1'b0 && row_addr[bank_addr] < 16'h2000) begin
+        sdram_write({6'b0,id}, {6'b0,bank_addr}, {16'b0, row_addr[bank_addr]}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, {{16{1'b0}}, dq});
+      end
+      else if(id[1] == 1'b1 && row_addr[bank_addr] >= 16'h2000) begin
+        sdram_write({6'b0,id}, {6'b0,bank_addr}, {16'b0, row_addr[bank_addr]}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, {{16{1'b0}}, dq});
+      end
       burst_counter <= burst_counter + 1;
     end
     else if(w_en) begin
@@ -176,6 +390,6 @@ module sdram(
 
 
