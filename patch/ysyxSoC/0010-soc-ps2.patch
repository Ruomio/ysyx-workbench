From ee47049e87075c32b8fcce2d461e98ac808b496f Mon Sep 17 00:00:00 2001
From: Ruomio <1065940593@qq.com>
Date: Fri, 7 Mar 2025 15:01:30 +0800
Subject: [PATCH 10/26] soc: ps2

---
 perip/ps2/ps2_keyboard.v | 56 ++++++++++++++++++++++++++++++++++++++++
 perip/ps2/ps2_top_apb.v  | 46 +++++++++++++++++++++++++++++++++
 2 files changed, 102 insertions(+)
 create mode 100644 perip/ps2/ps2_keyboard.v

diff --git a/perip/ps2/ps2_keyboard.v b/perip/ps2/ps2_keyboard.v
new file mode 100644
index 00000000..061ab42a
--- /dev/null
+++ b/perip/ps2/ps2_keyboard.v
@@ -0,0 +1,56 @@
+module ps2_keyboard(clk,clrn,ps2_clk,ps2_data,data,
+                    ready,nextdata_n,overflow);
+    input clk,clrn,ps2_clk,ps2_data;
+    input nextdata_n;
+    output [7:0] data;
+    output reg ready;
+    output reg overflow;     // fifo overflow
+    // internal signal, for test
+    reg [9:0] buffer;        // ps2_data bits
+    reg [7:0] fifo[7:0];     // data fifo
+    reg [2:0] w_ptr,r_ptr;   // fifo write and read pointers
+    reg [3:0] count;  // count ps2_data bits
+    // detect falling edge of ps2_clk
+    reg [2:0] ps2_clk_sync;
+
+    always @(posedge clk) begin
+        ps2_clk_sync <=  {ps2_clk_sync[1:0],ps2_clk};
+    end
+
+    wire sampling = ps2_clk_sync[2] & ~ps2_clk_sync[1];
+
+    always @(posedge clk) begin
+        if (clrn == 0) begin // reset
+            count <= 0; w_ptr <= 0; r_ptr <= 0; overflow <= 0; ready<= 0;
+        end
+        else begin
+            if ( ready ) begin // read to output next data
+                if(nextdata_n == 1'b0) //read next data
+                begin
+                    r_ptr <= r_ptr + 3'b1;
+                    if(w_ptr==(r_ptr+1'b1)) //empty
+                        ready <= 1'b0;
+                end
+            end
+            if (sampling) begin
+              if (count == 4'd10) begin
+                if ((buffer[0] == 0) &&  // start bit
+                    (ps2_data)       &&  // stop bit
+                    (^buffer[9:1])) begin      // odd  parity
+                    // $display("get ps data: %h", buffer[8:1]);
+                    fifo[w_ptr] <= buffer[8:1];  // kbd scan code
+                    w_ptr <= w_ptr+3'b1;
+                    ready <= 1'b1;
+                    overflow <= overflow | (r_ptr == (w_ptr + 3'b1));
+                end
+                count <= 0;     // for next
+              end else begin
+                buffer[count] <= ps2_data;  // store ps2_data
+                count <= count + 3'b1;
+              end
+            end
+        end
+    end
+    assign data = fifo[r_ptr]; //always set output data
+
+endmodule
\ No newline at end of file
diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..3ffb600f 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -15,5 +15,51 @@ module ps2_top_apb(
   input         ps2_clk,
   input         ps2_data
 );
+  // ps2_keyboard
+  reg [7:0] data;
+  reg nextdata_n;
+  wire ready;
+  wire overflow;
 
+
+  // top_apb
+  wire reg_re;
+  wire reg_we;
+  reg [31:0] prdata;
+
+  assign in_pready = in_psel && in_penable;
+  assign in_pslverr = 1'b0;
+  assign reg_we  = ~reset & in_psel & ~in_penable &  in_pwrite;
+  assign reg_re  = ~reset & in_psel & ~in_penable & ~in_pwrite;
+  assign in_prdata  = (ready) ? prdata : 'h0;
+  always @(posedge clock) begin
+    if(reset) begin
+      prdata <= 32'h0;
+    end
+    else if(reg_we) begin
+      $error("Could not wirte keyboard");
+    end
+    else if(reg_re) begin
+      prdata <= {24'b0, data[7:0]};
+      nextdata_n = 1'b0;
+      // $display("read data; addr:%h strb:%h", in_paddr, in_pstrb);
+    end
+    else begin
+      nextdata_n = 1'b1;
+    end
+  
+  end
+
+
+
+  ps2_keyboard u_key(
+    .clk(clock),
+    .clrn(~reset),
+    .ps2_clk(ps2_clk),
+    .ps2_data(ps2_data),
+    .nextdata_n(nextdata_n),
+    .data(data),
+    .ready(ready),
+    .overflow(overflow)
+  );
 endmodule
