From 2031637dda0288b09bc48056a74bd458562c1a71 Mon Sep 17 00:00:00 2001
From: Ruomio <1065940593@qq.com>
Date: Tue, 14 Jan 2025 13:38:03 +0800
Subject: [PATCH 05/23] soc: sdram achive

---
 perip/sdram/sdram.v | 166 +++++++++++++++++++++++++++++++++++++++++++-
 rocket-chip         |   1 -
 2 files changed, 165 insertions(+), 2 deletions(-)
 delete mode 160000 rocket-chip

diff --git a/perip/sdram/sdram.v b/perip/sdram/sdram.v
index 3613b231..ce707858 100644
--- a/perip/sdram/sdram.v
+++ b/perip/sdram/sdram.v
@@ -10,7 +10,171 @@ module sdram(
   input [ 1:0] dqm,
   inout [15:0] dq
 );
+  import "DPI-C" function void sdram_read(input byte ba, input int row_addr, input int col_addr, input shortint wstrb, output shortint rdata);
+  import "DPI-C" function void sdram_write(input byte ba, input int row_addr, input int col_addr, input shortint wstrb, input shortint wdata);
 
-  assign dq = 16'bz;
+  // Internal registers and wires
+  // reg [15:0] memory [0:262143]; // 256Mb SDRAM (16M x 16)
+  reg [15:0] dq_out;
+  reg dq_en;
+  reg [12:0] row_addr;
+  reg [1:0] bank_addr;
+  reg [9:0] col_addr;
+  reg [2:0] burst_length;
+  reg [1:0] cas_latency;
+  reg [2:0] burst_counter;
+  reg [1:0] cas_counter;
+  reg auto_precharge;
+  reg [12:0] mode_register;
+
+
+  reg r_en;
+  reg w_en;
+
+  wire [15:0] wstrb;
+  // reg [15:0] wstrb_1;
+
+  // Command decoding
+  wire cmd_nop = ~cs & ras & cas & we;
+  wire cmd_active = ~cs & ~ras & cas & we;
+  wire cmd_read = ~cs & ras & ~cas & we;
+  wire cmd_write = ~cs & ras & ~cas & ~we;
+  wire cmd_precharge = ~cs & ~ras & cas & ~we;
+  wire cmd_refresh = ~cs & ~ras & cas & ~we;
+  wire cmd_burst_term = ~cs & ras & cas & ~we;
+  wire cmd_load_mode = ~cs & ~ras & ~cas & ~we;
+
+  // wstrb
+  assign wstrb = { {8{~dqm[1]}}, {8{~dqm[0]}} }; 
+  //always @(posedge clk) begin
+  //  wstrb_1 <= { {8{~dqm[1]}}, {8{~dqm[0]}} }; 
+  //end
+  //always @(posedge clk) begin
+  //  wstrb <= wstrb_1; 
+  //end
+
+  // cke
+  always @(posedge clk) begin
+    if(!cke) begin
+      cas_counter <= 2'b0;
+      r_en <= 1'b0;
+      w_en <= 1'b0;
+    end
+  end
+  // Initialize mode register
+  always @(posedge clk) begin
+    if (cmd_load_mode) begin
+      mode_register <= a; // Burst length and CAS latency
+      burst_length <= a[2:0];
+      cas_latency <= a[5:4];
+    end
+  end
+
+  // Activate command
+  always @(posedge clk) begin
+    if (cmd_active) begin
+      row_addr <= a;
+      bank_addr <= ba;
+    end
+  end
+
+  // Read command
+  always @(posedge clk) begin
+    if (cmd_read) begin
+      r_en <= 1'b1;
+      col_addr <= a[9:0];
+      auto_precharge <= a[10];
+      burst_counter <= 0;
+      cas_counter <= 2'b1;
+    end
+  end
+
+  // Write command
+  always @(posedge clk) begin
+    if (cmd_write) begin
+      w_en <= 1'b1;
+      col_addr <= a[9:0];
+      auto_precharge <= a[10];
+      burst_counter <= 1;
+      // memory[{bank_addr, row_addr, col_addr}] <= dq;
+      sdram_write({6'b0, bank_addr}, {19'b0, row_addr}, {22'b0, a[9:0]}, wstrb, dq & wstrb);
+    end
+  end
+
+  // Precharge command
+  always @(posedge clk) begin
+    if (cmd_precharge) begin
+      // if (a[10]) begin
+      //   // Precharge all banks
+      //   row_addr <= 13'b0;
+      //   bank_addr <= 2'b0;
+      // end else begin
+      //   // Precharge selected bank
+      //   row_addr <= 13'b0;
+      // end
+    end
+  end
+
+  // Burst terminate command
+  always @(posedge clk) begin
+    if (cmd_burst_term) begin
+      burst_counter <= 0;
+      r_en <= 1'b0;
+      w_en <= 1'b0;
+
+    end
+  end
+
+  // Data output
+  always @(posedge clk) begin
+    if (r_en && cas_counter == cas_latency - 2'b1 && burst_counter > burst_length) begin
+      r_en <= 1'b0;
+      cas_counter <= 2'b0;
+      burst_counter <= 3'b0;
+      dq_en <= 1'b0;
+    end
+    else if (r_en && cas_counter == cas_latency - 2'b1 && burst_counter <= burst_length) begin
+      //  dq_out <= memory[{bank_addr, row_addr, col_addr + burst_counter}];
+      sdram_read({6'b0,bank_addr}, {19'b0, row_addr}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, dq_out);
+      dq_en <= 1;
+      burst_counter <= burst_counter + 1;
+    end
+    else if(r_en) begin
+      cas_counter <= cas_counter + 1;
+      dq_en <= 0;
+    end
+    else begin
+
+    end
+  end
+
+  // Data input
+  always @(posedge clk) begin
+    if (w_en && burst_counter > burst_length) begin
+      w_en <= 1'b0;
+      burst_counter <= 3'b0;
+    end
+    else if (w_en && burst_counter <= burst_length) begin
+      //  dq_out <= memory[{bank_addr, row_addr, col_addr + burst_counter}];
+      sdram_write({6'b0,bank_addr}, {19'b0, row_addr}, {22'b0, col_addr} + {29'b0, burst_counter}, wstrb, dq & wstrb);
+      burst_counter <= burst_counter + 1;
+    end
+    else if(w_en) begin
+    end
+    else begin
+
+    end
+  end
+  // NOP
+  always @(posedge clk) begin
+    if(r_en) begin
+
+
+    end
+
+  end
+
+  // Data bus control
+  assign dq = dq_en ? dq_out : 16'bz;
 
 endmodule
diff --git a/rocket-chip b/rocket-chip
deleted file mode 160000
index d0c6b50f..00000000
--- a/rocket-chip
+++ /dev/null
@@ -1 +0,0 @@
