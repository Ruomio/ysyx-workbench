From dd6bad54bd930d3e17fede11865971b864c48ad4 Mon Sep 17 00:00:00 2001
From: Ruomio <1065940593@qq.com>
Date: Tue, 28 Oct 2025 17:36:23 +0800
Subject: [PATCH] delete quit command from initial uart line

---
 bsp/abstract-machine/extra-soc.ld | 9 ---------
 bsp/abstract-machine/src/uart.c   | 2 +-
 2 files changed, 1 insertion(+), 10 deletions(-)

diff --git a/bsp/abstract-machine/extra-soc.ld b/bsp/abstract-machine/extra-soc.ld
index 0e5381050..b60ee130a 100644
--- a/bsp/abstract-machine/extra-soc.ld
+++ b/bsp/abstract-machine/extra-soc.ld
@@ -1,12 +1,3 @@
-MEMORY
-{
-  /* MROM (rx) : ORIGIN = 0x20000000, LENGTH = 0x1000 */       /* 4K */
-  SRAM (rwx) : ORIGIN = 0x0f000000, LENGTH = 0x2000            /* 8k */
-  FLASH (rx) : ORIGIN = 0x30000000, LENGTH = 0x01000000        /* 2^24 = 16M */
-  PSRAM (rwx) : ORIGIN = 0x80000000, LENGTH = 0x00400000       /* 4M */
-  SDRAM (rwx) : ORIGIN = 0xa0000000, LENGTH = 0x02000000       /* 32M */
-}
-
 SECTIONS {
   .data.extra : {
     . = ALIGN(8);
diff --git a/bsp/abstract-machine/src/uart.c b/bsp/abstract-machine/src/uart.c
index b0f097d44..1f78db305 100644
--- a/bsp/abstract-machine/src/uart.c
+++ b/bsp/abstract-machine/src/uart.c
@@ -38,7 +38,7 @@ static int _uart_putc(struct rt_serial_device *serial, char c) {
 }
 
 static int _uart_getc(struct rt_serial_device *serial) {
-  static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\nam_hello\nq\n";
+  static const char *p = "help\ndate\nversion\nfree\nps\npwd\nls\nmemtrace\nmemcheck\nutest_list\nam_hello\n";
   return (*p != '\0' ? *(p ++) : io_read(AM_UART_RX).data);
 }
 
