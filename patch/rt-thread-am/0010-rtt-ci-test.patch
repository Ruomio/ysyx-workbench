 # LDFLAGS += -T $(AM_HOME)/scripts/linker-ysyxsoc-rtt.ld
 LDFLAGS += -T extra-soc.ld
 CFLAGS += -DYSYXSOC
-else
+endif
+ifeq ($(PLATFORM), npc)
 LDFLAGS += -T extra.ld
+CFLAGS += -DNPC
 endif
 
