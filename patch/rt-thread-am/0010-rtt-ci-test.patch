+  // copy .data.extra
+  // memcpy((void *)(uintptr_t)&_data_extra_start, (void *)(uintptr_t)&_data_extra_load, (uintptr_t)&_data_extra_end - (uintptr_t)&_data_extra_start);
+  // init .bss.extra
+  memset((void *)(uintptr_t)&__am_apps_bss_start, 0, (uintptr_t)&__am_apps_bss_end - (uintptr_t)&__am_apps_bss_start);
+  // memcpy((void *)(uintptr_t)&_bss_extra_start, (void *)(uintptr_t)&_bss_extra_load, (uintptr_t)&_bss_extra_end - (uintptr_t)&_bss_extra_start);
+#endif
 
