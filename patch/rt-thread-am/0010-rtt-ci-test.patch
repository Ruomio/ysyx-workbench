   memset((void *)(uintptr_t)&_bss_extra_start, 0, (uintptr_t)&_bss_extra_end - (uintptr_t)&_bss_extra_start);
   // memcpy((void *)(uintptr_t)&_bss_extra_start, (void *)(uintptr_t)&_bss_extra_load, (uintptr_t)&_bss_extra_end - (uintptr_t)&_bss_extra_start);
