VERILATOR=verilator
VERILATOR_CFLAGS += -MMD --build -cc \
					-j 0 -threads 2  \
					-O3 --x-assign fast --x-initial fast --noassert --trace \
					--timescale "1ns/1ns" --no-timing

TOPNAME=ysyxSoCFull
NXDC_FILES = constr/top.nxdc

remove_quote = $(patsubst "%",%,$(1))

CSRC=$(shell find $(abspath ./csrc) -name "*.cpp" -or -name "*.c") 
HSRC=$(shell find $(abspath ./include) -name "*.h") 
# CSRC=$(shell find csrc -name "*.cpp" -or -name "*.c") 
INC_PATH += $(shell find $(abspath ./) -type d -name "include")

VINC_PATH += $(shell find $(ysyxSoC_HOME)/perip -type d -name "rtl")
VINC_PATH += $(shell find $(NPC_HOME) -type d -name "vsrc")

VSRC += $(shell find $(abspath vsrc) -name "*.v") 
VSRC += $(shell find $(ysyxSoC_HOME)/perip -name "*.v")
VSRC += $(shell find $(ysyxSoC_HOME)/build -name "*.v")
VCD_FILE=build/wave.vcd
ELF_FILE_NAME=$(shell echo $(VSRC) | sed -E "s/vsrc\/([a-z\-]+)\.v/build\/obj_dir\/V\1/g" )
BUILD_DIR=$(shell pwd)/build
OBJ_DIR=$(BUILD_DIR)/obj_dir
BIN=$(BUILD_DIR)/$(TOPNAME)

$(shell mkdir -p $(BUILD_DIR))

default: all
# Include variables and rules generated by menuconfig
-include $(NPC_HOME)/include/config/auto.conf
-include $(NPC_HOME)/include/config/auto.conf.cmd

ifdef CONFIG_ITRACE
include $(NPC_HOME)/csrc/utils/filelist.mk
endif

# Extract variabls from menuconfig
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))

# Difftest to NEMU
DIFFTEST_REF_PATH = $(if CONFIG_DIFFTEST, "$(NEMU_HOME)/build/riscv32-nemu-interpreter-so")
DIFFTEST_REF_SO = $(call remove_quote,$(DIFFTEST_REF_PATH))



# constraint file
# SRC_AUTO_BIND = $(abspath $(BUILD_DIR)/auto_bind.cpp)
# $(SRC_AUTO_BIND): $(NXDC_FILES)
# 	python3 $(NVBOARD_HOME)/scripts/auto_pin_bind.py $^ $@

# project source
# VSRCS = $(shell find $(abspath ./vsrc) -name "*.v")
# CSRCS = $(shell find $(abspath ./csrc) -name "*.c" -or -name "*.cc" -or -name "*.cpp")
# CSRCS += $(SRC_AUTO_BIND)
# 
# # parameters 
override ARGS ?= --log=$(BUILD_DIR)/npc-log.txt
override ARGS += --diff=$(DIFFTEST_REF_SO) $(NPCFLAGS)
override IMG +=


# rules for NVBoard
#include $(NVBOARD_HOME)/scripts/nvboard.mk

# rules for verilator
INCFLAGS = $(addprefix -I, $(INC_PATH))
CFLAGS += $(if $(CONFIG_DEBUG), -g)
CXXFLAGS += $(INCFLAGS) -DTOP_NAME="\"V$(TOPNAME)\"" $(if $(CONFIG_DEBUG), -g) -D__GUEST_ISA__=$(GUEST_ISA)
LDFLAGS += -lreadline -ldl -pie $(LIBS)
VERILATOR_CFLAGS  += $(addprefix -I, $(VINC_PATH))

CSRC_NODIR := $(notdir $(CSRC))
OBJS := $(CSRC_NODIR:%.c=$(OBJ_DIR)/%.o) $(CSRC_NODIR:%.cc=$(OBJ_DIR)/%.o) $(CSRC_NODIR:%.cpp=$(OBJ_DIR)/%.o)

$(OBJ_DIR)/%.o: %.c
	gcc $(INCFLAGS) $(CFLAGS) -c $< -o $@
	$(call call_fixdep, $(@:.o=.d), $@)
$(OBJ_DIR)/%.o: %.cc
	g++  $(INCFLAGS) $(CFLAGS) $(CXXFLAGS) -c $< -o $@
	$(call call_fixdep, $(@:.o=.d), $@)
$(OBJ_DIR)/%.o: %.cpp
	g++ $(INCFLAGS) $(CFLAGS) $(CXXFLAGS) -c $< -o $@
	$(call call_fixdep, $(@:.o=.d), $@)

all: $(BIN)

sim:
	$(call git_commit, "sim RTL") # DO NOT REMOVE THIS LINE!!!
	# @echo "Write this Makefile by your self.!"
	$(VERILATOR) -cc --exe --build --trace -j 8 -Mdir $(OBJ_DIR) $(VSRC) $(CSRC)

# nvboard: $(VSRCS) $(CSRCS) $(NVBOARD_ARCHIVE)
# 	$(call git_commit, "sim RTL") # DO NOT REMOVE THIS LINE!!!
# 	$(VERILATOR) $(VERILATOR_CFLAGS) \
# 		--top-module $(TOPNAME) $^ \
# 		$(addprefix -CFLAGS , $(CXXFLAGS)) $(addprefix -LDFLAGS , $(LDFLAGS)) \
# 		--Mdir $(OBJ_DIR) --exe -o $(abspath $(BIN))

$(BIN): $(VSRC) $(CSRC) $(HSRC)
	$(call git_commit, "sim NPC") # DO NOT REMOVE THIS LINE!!!
	@$(VERILATOR) $(VERILATOR_CFLAGS) \
		--top-module $(TOPNAME) $(VSRC) $(CSRC) \
		$(addprefix -CFLAGS , $(CXXFLAGS)) $(addprefix -LDFLAGS , $(LDFLAGS)) \
		--Mdir $(OBJ_DIR) --exe -o $(abspath $(BIN))

gtkwave: $(VCD_FILE)
	gtkwave $^

$(VCD_FILE):
	@$(ELF_FILE_NAME)

run: $(BIN)
	@$^ $(ARGS) $(IMG)
	$(call git_commit, "run NPC")

gdb: $(BIN)
	$(call git_commit, "gdb NPC")
	gdb -s $(BIN) --args $(BIN) $(ARGS) $(IMG)

lldb: $(BIN)
	$(call git_commit, "lldb NPC")
	lldb -- $(BIN) $(ARGS) $(IMG)

.PHONY: all clean gtkwave sim nvboard run

clean:
	@rm -rf $(BUILD_DIR) *.vcd

include ../Makefile
include scripts/config.mk


