# rules for NVBoard
#include $(NVBOARD_HOME)/scripts/nvboard.mk

# rules for verilator
INCFLAGS = $(addprefix -I, $(INC_PATH))
CFLAGS += $(if $(CONFIG_DEBUG), -g)
CXXFLAGS += $(INCFLAGS) -DTOP_NAME="\"V$(TOPNAME)\"" $(if $(CONFIG_DEBUG), -g)
LDFLAGS += -lreadline -ldl

# $(OBJ_DIR)/%.o: 
OBJS = $(CSRCS:%.c=$(OBJ_DIR)/%.o)

$(OBJ_DIR)/%.o: %.c
	gcc $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: %.cpp
	g++ $(CXXFLAGS) -c $< -o $@

sim:
	$(call git_commit, "sim RTL") # DO NOT REMOVE THIS LINE!!!
	# @echo "Write this Makefile by your self.!"
	$(VERILATOR) -cc --exe --build --trace -j 8 -Mdir $(OBJ_DIR) $(VSRC) $(CSRC)

# nvboard: $(VSRCS) $(CSRCS) $(NVBOARD_ARCHIVE)
# 	$(call git_commit, "sim RTL") # DO NOT REMOVE THIS LINE!!!
# 	$(VERILATOR) $(VERILATOR_CFLAGS) \
# 		--top-module $(TOPNAME) $^ \
# 		$(addprefix -CFLAGS , $(CXXFLAGS)) $(addprefix -LDFLAGS , $(LDFLAGS)) \
# 		--Mdir $(OBJ_DIR) --exe -o $(abspath $(BIN))

$(BIN): $(VSRC) $(CSRC) 
	$(call git_commit, "sim RTL") # DO NOT REMOVE THIS LINE!!!
	$(VERILATOR) $(VERILATOR_CFLAGS) \
		--top-module $(TOPNAME) $^ \
		$(addprefix -CFLAGS , $(CXXFLAGS)) $(addprefix -LDFLAGS , $(LDFLAGS)) \
		--Mdir $(OBJ_DIR) --exe -o $(abspath $(BIN))

gtkwave: $(VCD_FILE)
	gtkwave $^

$(VCD_FILE):
	@$(ELF_FILE_NAME)

run: $(BIN)
	@$^ $(ARGS) $(IMG)
	$(call git_commit, "run NPC")

gdb: $(BIN)
	$(call git_commit, "gdb NPC")
	gdb -s $(BIN) --args $(BIN) $(ARGS) $(IMG)

lldb: $(BIN)
	$(call git_commit, "lldb NPC")
	lldb -- $(BIN) $(ARGS) $(IMG)

.PHONY : all clean gtkwave sim nvboard run Kconfig 'include/config/auto.conf' deps_config

clean:
	@rm -rf $(BUILD_DIR) *.vcd

include ../Makefile
include scripts/config.mk
ifdef CONFIG_ITRACE
include $(NPC_HOME)/csrc/utils/filelist.mk
endif
