mainmenu "NPC Configuration"

choice
    prompt "Select ISA"
    default ISA_riscv32
config ISA_riscv32
    bool "select riscv32"
config ISA_riscv64
    bool "selsec riscv64"
endchoice

config ISA
  string
  default "x86" if ISA_x86
  default "mips32" if ISA_mips32
  default "riscv32" if ISA_riscv32
  default "riscv64" if ISA_riscv64
  default "loongarch32r" if ISA_loongarch32r
  default "none"

menu "Build options"
    config DEBUG
        bool "is enable -g parameter when compiling"
        default n
    
    config WAVEFILE
        bool "is generate wave file"
        default n

    config MAX_WAVE_STEP
        depends on WAVEFILE
        int "Max wave step"
        default "20000"

    config BASE_WAVE_STEP
        depends on WAVEFILE
        int "Base wave step"
        default "0"
endmenu

menu "Memory setting"
    config MBASE
        hex "Memory base address"
        default "0x0"
    config MSIZE
        hex "Memory size"
        default "0x0"
endmenu

menu "Test and debug"
    config ITRACE
        bool "enable inst trace"
        default n
    config MTRACE
        bool "enable memory trace"
        default n
    config FTRACE
        bool "enable function trace"
        default n
    config WATCH_POINT
        bool "enable watch point"
        default n
    config DIFFTEST
        bool "enable difftest"
        default n
endmenu

menuconfig DEVICE
    bool "Device"
    default n
    help 
        Provide devices support for NPC.

if DEVICE
menuconfig HAS_SERIAL
    bool "Enable serial"
    default y

if HAS_SERIAL
config SERIAL_MMIO
    hex "Memory address of serial controller"
    default 0xa00003f8
endif

menuconfig HAS_TIMER
    bool "Enable timer"
    default y

if HAS_TIMER
config RTC_MMIO
    hex "Memory address of timer controller"
    default 0xa0000048
endif

endif # endif DEVICES
